{
  "expo": {
    "name": "Flashcardex",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconito.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/iconito.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jakeblack.flashcardex",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconito.png",
        "backgroundColor": "#00000000"
      },
      "package": "com.jakeblack.flashcardex",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "56aa71c5-769a-4366-a5af-255a9c3b42c0"
      }
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "@react-native-google-signin/google-signin"
    ],
    "owner": "jakeblack",
    "cli": {
      "appVersionSource": "local"
    }
  }
}
